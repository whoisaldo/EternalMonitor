// EternalMonitor protocol schema — FlatBuffers
// Used for documentation and Swift codegen (Phase 5).
// Rust side uses the flatbuffers runtime builder API directly.

table FramePacket {
  seq:          uint32;
  timestamp_us: uint64;
  data:         [ubyte];
  width:        uint32;
  height:       uint32;
  is_keyframe:  bool;
}

enum ControlKind: byte {
  Connect = 0,
  Disconnect = 1,
  Ping = 2,
}

table ControlMsg {
  kind: ControlKind;
}

root_type FramePacket;
